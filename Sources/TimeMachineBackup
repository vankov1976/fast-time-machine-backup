#!/bin/bash
# Back up every destination configured in Time Machine.
# Extra exclusions are marked for the run and removed when it exits.
# Transfer optimizations run only while a remote destination is being copied.

LOCKDIR=/var/run/local.fasttimemachine.backup.lock
LOG=/var/log/local.fasttimemachine.backup.log
NSMB=/etc/nsmb.conf
NSMB_BAK=/etc/nsmb.conf.tmbackup-saved
exclusions_file() {
    local console home bundled
    console=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)
    if [ -z "$console" ] || [ "$console" = "root" ] || [ "$console" = "loginwindow" ]; then
        console=$(/usr/bin/defaults read /Library/Preferences/com.apple.loginwindow lastUserName 2>/dev/null || true)
    fi
    home=""
    if [ -n "$console" ]; then
        home=$(/usr/bin/dscl . -read "/Users/${console}" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')
        if [ -z "$home" ]; then
            home="/Users/${console}"
        fi
    fi
    bundled="$(cd "$(dirname "$0")/.." && pwd)/Resources/exclusions.txt"
    if [ -n "$home" ] && [ -f "$home/Library/Application Support/local.fasttimemachine.backup/exclusions.txt" ]; then
        printf '%s\n' "$home/Library/Application Support/local.fasttimemachine.backup/exclusions.txt"
        return
    fi
    if [ -f "$bundled" ]; then
        printf '%s\n' "$bundled"
        return
    fi
    if [ -n "$home" ]; then
        printf '%s\n' "$home/Library/Application Support/local.fasttimemachine.backup/exclusions.txt"
    else
        printf '%s\n' "$bundled"
    fi
}
EXCLUSIONS_FILE="$(exclusions_file)"
MARKS=/var/run/local.fasttimemachine.backup.marks
EXCLUDE_ATTR='com.apple.metadata:com_apple_backup_excludeItem'
marks_on=0
tweaks_on=0
nsmb_on=0
had_nsmb=0

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG"
}

# One destination per line: id, kind, name, url. Fields are separated by tabs.
read_destinations() {
    /usr/bin/awk '
        function flush() {
            if (id != "") print id "\t" kind "\t" name "\t" url
        }
        /^====/ { flush(); id = ""; kind = ""; name = ""; url = ""; next }
        /^Name[[:space:]]*:/ { sub(/^[^:]*:[[:space:]]*/, ""); name = $0; next }
        /^Kind[[:space:]]*:/ { sub(/^[^:]*:[[:space:]]*/, ""); kind = $0; next }
        /^URL[[:space:]]*:/ { sub(/^[^:]*:[[:space:]]*/, ""); url = $0; next }
        /^ID[[:space:]]*:/ { sub(/^[^:]*:[[:space:]]*/, ""); id = $0; next }
        END { flush() }
    '
}

# Prints: scope, mode, host, port. Fields are separated by tabs.
destination_plan() {
    local kind="$1" url="$2"
    KIND="$kind" URL="$url" /usr/bin/python3 - <<'PY'
import os
from urllib.parse import urlparse
kind = os.environ.get("KIND", "")
url = os.environ.get("URL", "")
parsed = urlparse(url) if url else None
scheme = (parsed.scheme.lower() if parsed else "")
host = ""
if parsed is not None:
    netloc = parsed.netloc
    if "@" in netloc:
        netloc = netloc.rsplit("@", 1)[1]
    if netloc.startswith("["):
        host = parsed.hostname or ""
    else:
        host = netloc.split(":")[0]
remote = kind.lower() == "network" or scheme in {"smb", "afp", "nfs", "cifs"}
ports = {"smb": "445", "cifs": "445", "afp": "548", "nfs": "2049"}
if not remote:
    print("local\tother\t\t")
elif scheme in {"smb", "cifs"}:
    print(f"remote\tsmb\t{host}\t{ports.get(scheme, '')}")
else:
    print(f"remote\tother\t{host}\t{ports.get(scheme, '')}")
PY
}

unmount_tm() {
    local p
    shopt -s nullglob
    for p in /Volumes/.timemachine/* /Volumes/.timemachine/*/* /Volumes/.timemachine/*/*/* \
        /Volumes/Backups\ von\ * /Volumes/Backups\ of\ *; do
        [ -e "$p" ] || continue
        /usr/sbin/diskutil unmount force "$p" >/dev/null 2>&1 || true
    done
    shopt -u nullglob
}

restore_nsmb() {
    if [ "$nsmb_on" -ne 1 ]; then
        return 0
    fi
    if [ "$had_nsmb" -eq 1 ]; then
        mv -f "$NSMB_BAK" "$NSMB"
    else
        rm -f "$NSMB"
    fi
    nsmb_on=0
    had_nsmb=0
}

disable_tweaks() {
    restore_nsmb
    if [ "$tweaks_on" -eq 1 ]; then
        /usr/sbin/sysctl debug.lowpri_throttle_enabled=1 >/dev/null 2>&1 || true
        /sbin/ifconfig awdl0 up >/dev/null 2>&1 || true
        tweaks_on=0
        log "transfer optimizations off"
    fi
}

# $1 is smb or other. Used only for a remote destination.
enable_tweaks() {
    local mode="$1"
    if [ "$tweaks_on" -eq 0 ]; then
        /sbin/ifconfig awdl0 down >/dev/null 2>&1 || true
        /usr/sbin/sysctl debug.lowpri_throttle_enabled=0 >/dev/null 2>&1 || true
        tweaks_on=1
        log "transfer optimizations on (AirDrop radio down, low priority off)"
    fi
    if [ "$mode" = "smb" ]; then
        if [ "$nsmb_on" -eq 0 ]; then
            if [ -f "$NSMB" ]; then
                cp -p "$NSMB" "$NSMB_BAK"
                had_nsmb=1
            fi
            cat >"$NSMB" <<'EOF'
[default]
signing_required=no
notify_off=yes
protocol_vers_map=4
EOF
            nsmb_on=1
            log "SMB optimizations on (signing off, notifications off, SMB3)"
        fi
        unmount_tm
    elif [ "$nsmb_on" -eq 1 ]; then
        restore_nsmb
        log "SMB optimizations off"
        unmount_tm
    fi
}

host_ready() {
    local host="$1" port="$2" i
    [ -n "$host" ] || return 0
    for i in $(seq 1 40); do
        if /sbin/ping -c 1 -t 1 "$host" >/dev/null 2>&1; then
            return 0
        fi
        if [ -n "$port" ] && /usr/bin/nc -z -G 1 "$host" "$port" >/dev/null 2>&1; then
            return 0
        fi
        sleep 2
    done
    return 1
}

unmark_exclusions() {
    if [ "$marks_on" -ne 1 ] || [ ! -f "$MARKS" ]; then
        return 0
    fi
    local removed
    removed=$(MARKS_FILE="$MARKS" ATTR="$EXCLUDE_ATTR" /usr/bin/python3 - <<'PY'
import ctypes, os
libc = ctypes.CDLL("/usr/lib/libSystem.B.dylib", use_errno=True)
attr = os.environ["ATTR"].encode()
removed = 0
with open(os.environ["MARKS_FILE"], encoding="utf-8") as handle:
    paths = [line.rstrip("\n") for line in handle if line.strip()]
for path in paths:
    if libc.removexattr(path.encode(), attr, 1) == 0:
        removed += 1
print(removed)
PY
)
    log "removed $removed exclusion marks"
    rm -f "$MARKS"
    marks_on=0
}

restore() {
    unmark_exclusions
    disable_tweaks
    rm -rf "$LOCKDIR"
}

if [ "$(id -u)" -ne 0 ]; then
    exec "$(cd "$(dirname "$0")" && pwd)/BackupMenu"
fi

if ! mkdir "$LOCKDIR" 2>/dev/null; then
    old=$(cat "$LOCKDIR/pid" 2>/dev/null || true)
    if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
        log "already running (pid $old), skip"
        exit 0
    fi
    rm -rf "$LOCKDIR"
    mkdir "$LOCKDIR" 2>/dev/null || exit 0
fi
echo $$ >"$LOCKDIR/pid"
trap restore EXIT
log "invoked pid $$"

dest_file=$(mktemp)
/usr/bin/tmutil destinationinfo 2>/dev/null | read_destinations >"$dest_file" || true
dest_count=$(grep -c . "$dest_file" || true)
if [ "$dest_count" -eq 0 ]; then
    log "no Time Machine destination configured, skip"
    rm -f "$dest_file"
    exit 0
fi
log "Time Machine destinations: $dest_count"

EXCLUSIONS=()
if [ -f "$EXCLUSIONS_FILE" ]; then
    while IFS= read -r p || [ -n "$p" ]; do
        case "$p" in
            ''|\#*) continue ;;
        esac
        EXCLUSIONS+=("$p")
    done <"$EXCLUSIONS_FILE"
else
    log "exclusion list missing: $EXCLUSIONS_FILE"
fi

want=$(mktemp)
printf '%s\n' "${EXCLUSIONS[@]}" >"$want"
sort -u "$want" -o "$want"
mark_result=$(PATHS_FILE="$want" MARKS_FILE="$MARKS" ATTR="$EXCLUDE_ATTR" /usr/bin/python3 - <<'PY'
import ctypes, os, plistlib
libc = ctypes.CDLL("/usr/lib/libSystem.B.dylib", use_errno=True)
attr = os.environ["ATTR"].encode()
value = plistlib.dumps("com.apple.backupd", fmt=plistlib.FMT_BINARY)
buf = ctypes.create_string_buffer(value)
marked = []
failed = 0
missing = 0
with open(os.environ["PATHS_FILE"], encoding="utf-8") as handle:
    paths = [line.rstrip("\n") for line in handle if line.strip()]
for path in paths:
    raw = path.encode()
    if not os.path.lexists(path):
        missing += 1
        continue
    if libc.getxattr(raw, attr, None, 0, 0, 1) >= 0:
        continue
    if libc.setxattr(raw, attr, buf, len(value), 0, 1) == 0:
        marked.append(path)
    else:
        failed += 1
with open(os.environ["MARKS_FILE"], "w", encoding="utf-8") as handle:
    for path in marked:
        handle.write(path + "\n")
print(len(paths), len(marked), failed, missing)
PY
)
rm -f "$want"
marks_on=1
log "exclusion marks applied for this run ($mark_result = listed, newly marked, failed, missing)"

failed=0
while IFS="$(printf '\t')" read -r id kind name url; do
    [ -n "$id" ] || continue
    plan=$(destination_plan "$kind" "$url")
    scope=${plan%%$'\t'*}
    rest=${plan#*$'\t'}
    mode=${rest%%$'\t'*}
    rest=${rest#*$'\t'}
    host=${rest%%$'\t'*}
    port=${rest#*$'\t'}
    log "destination $name kind=$kind scope=$scope mode=$mode host=${host:-none} url=${url:-none} id=$id"
    if [ "$scope" = "remote" ]; then
        if ! host_ready "$host" "$port"; then
            log "remote destination $name is not reachable, skip"
            failed=1
            continue
        fi
        enable_tweaks "$mode"
    else
        disable_tweaks
        log "local destination $name, transfer optimizations skipped"
    fi
    log "start backup $name"
    err=$(mktemp)
    if /usr/bin/tmutil startbackup --auto --block --destination "$id" >"$err" 2>&1; then
        status=0
    else
        status=$?
    fi
    while IFS= read -r line; do
        [ -n "$line" ] && log "backup: $line"
    done <"$err"
    rm -f "$err"
    log "backup $name exit $status"
    if [ "$status" -ne 0 ]; then
        failed=1
    fi
done <"$dest_file"
rm -f "$dest_file"

log "done"
exit "$failed"
